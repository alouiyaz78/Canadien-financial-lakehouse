{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "Headline KPIs",
      "queryLines": [
        "SELECT\n",
        "  (SELECT yield_pct FROM workspace.cfl.bi_fact_yield_curve WHERE tenor = 'Overnight' ORDER BY date DESC LIMIT 1) AS policy_rate,\n",
        "  (SELECT round(cpi_headline_yoy, 1) FROM workspace.cfl.bi_mart_macro_monthly WHERE cpi_headline_yoy IS NOT NULL ORDER BY month DESC LIMIT 1) AS headline_cpi,\n",
        "  (SELECT round(core_avg, 1) FROM workspace.cfl.bi_mart_macro_monthly WHERE core_avg IS NOT NULL ORDER BY month DESC LIMIT 1) AS core_inflation,\n",
        "  (SELECT sum(signal) FROM workspace.cfl.bi_mart_policy_signals) AS net_stance,\n",
        "  (SELECT datediff(min(date), current_date()) FROM workspace.cfl.bi_fact_policy_calendar WHERE date >= current_date()) AS days_to_decision,\n",
        "  (SELECT round(100 * avg(CASE WHEN status IN ('ok', 'retired') THEN 1 ELSE 0 END)) FROM workspace.cfl.freshness_report) AS fresh_pct"
      ]
    },
    {
      "name": "taylor",
      "displayName": "Policy rate vs Taylor rule",
      "queryLines": [
        "SELECT month, series, value FROM workspace.cfl.bi_mart_macro_monthly LATERAL VIEW stack(2, 'Policy rate', policy_rate, 'Taylor rule', taylor_rule_rate) s AS series, value WHERE month >= DATE'2000-01-01' AND value IS NOT NULL"
      ]
    },
    {
      "name": "inflation",
      "displayName": "Inflation vs target",
      "queryLines": [
        "SELECT month, series, value FROM workspace.cfl.bi_mart_macro_monthly LATERAL VIEW stack(5, 'Headline CPI', cpi_headline_yoy, 'CPI-trim', cpi_trim, 'CPI-median', cpi_median, 'Band low (1%)', target_low, 'Band high (3%)', target_high) s AS series, value WHERE month >= DATE'2015-01-01' AND value IS NOT NULL"
      ]
    },
    {
      "name": "signals",
      "displayName": "Hawkish / dovish scorecard",
      "queryLines": [
        "SELECT indicator, round(latest_value, 2) AS latest_value, unit, signal_label FROM workspace.cfl.bi_mart_policy_signals ORDER BY signal DESC, indicator"
      ]
    },
    {
      "name": "curve",
      "displayName": "Yield curve today vs one year ago",
      "queryLines": [
        "WITH last_day AS (SELECT max(date) AS d FROM workspace.cfl.bi_fact_yield_curve),\n",
        "year_ago AS (SELECT max(c.date) AS d FROM workspace.cfl.bi_fact_yield_curve c, last_day WHERE c.date <= date_sub(last_day.d, 365))\n",
        "SELECT 'Today' AS curve, c.tenor_months, c.yield_pct FROM workspace.cfl.bi_fact_yield_curve c JOIN last_day ON c.date = last_day.d\n",
        "UNION ALL\n",
        "SELECT 'One year ago', c.tenor_months, c.yield_pct FROM workspace.cfl.bi_fact_yield_curve c JOIN year_ago ON c.date = year_ago.d"
      ]
    },
    {
      "name": "oil",
      "displayName": "WTI in USD vs CAD",
      "queryLines": [
        "SELECT month, series, value FROM workspace.cfl.bi_mart_macro_monthly LATERAL VIEW stack(2, 'WTI (USD)', wti_usd, 'WTI (CAD)', wti_cad) s AS series, value WHERE month >= DATE'2020-01-01' AND value IS NOT NULL"
      ]
    },
    {
      "name": "passthrough",
      "displayName": "Energy to core pass-through",
      "queryLines": [
        "SELECT lag_months, round(corr_core, 3) AS corr_core FROM workspace.cfl.bi_mart_energy_passthrough"
      ]
    },
    {
      "name": "tariffs",
      "displayName": "Effective US tariff rates",
      "queryLines": [
        "SELECT month, series, value FROM workspace.cfl.bi_mart_macro_monthly LATERAL VIEW stack(3, 'Canada', us_tariff_rate_on_canada, 'Mexico', us_tariff_rate_on_mexico, 'China', us_tariff_rate_on_china) s AS series, value WHERE month >= DATE'2023-01-01' AND value IS NOT NULL"
      ]
    },
    {
      "name": "mortgage",
      "displayName": "Mortgage renewal shock",
      "queryLines": [
        "SELECT month, series, value FROM workspace.cfl.bi_mart_macro_monthly LATERAL VIEW stack(2, 'Rate today', mortgage_5y, 'Rate signed 5 years earlier', mortgage_5y_at_origination) s AS series, value WHERE month >= DATE'2015-01-01' AND value IS NOT NULL"
      ]
    },
    {
      "name": "freshness_status",
      "displayName": "Freshness status",
      "queryLines": [
        "SELECT status, count(*) AS series FROM workspace.cfl.freshness_report GROUP BY status"
      ]
    },
    {
      "name": "freshness_late",
      "displayName": "Freshness by series",
      "queryLines": [
        "SELECT name, status, source, CAST(last_date AS STRING) AS last_date, age_days, max_age_days FROM workspace.cfl.freshness_report ORDER BY age_days / max_age_days DESC"
      ]
    },
    {
      "name": "ingestion",
      "displayName": "Ingestion activity (30 days)",
      "queryLines": [
        "SELECT to_date(ingested_at) AS day,\n",
        "  CASE WHEN status = 'error' THEN 'error' WHEN changed THEN 'new data' ELSE 'unchanged' END AS outcome,\n",
        "  count(*) AS series\n",
        "FROM workspace.cfl.bronze_ingestion_log\n",
        "WHERE to_date(ingested_at) >= date_sub(current_date(), 30)\n",
        "GROUP BY ALL"
      ]
    }
  ],
