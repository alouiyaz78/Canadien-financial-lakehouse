	measure 'Latest Tariff on China (%)' =
			VAR M = CALCULATE ( MAX ( bi_mart_macro_monthly[month] ), NOT ISBLANK ( bi_mart_macro_monthly[us_tariff_rate_on_china] ), REMOVEFILTERS ( bi_dim_date ) )
			RETURN CALCULATE ( AVERAGE ( bi_mart_macro_monthly[us_tariff_rate_on_china] ), bi_mart_macro_monthly[month] = M, REMOVEFILTERS ( bi_dim_date ) )
		formatString: 0.00
