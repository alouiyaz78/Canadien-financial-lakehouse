	measure 'Peak Lag to Core (months)' =
			MAXX (
			    TOPN ( 1, bi_mart_energy_passthrough, bi_mart_energy_passthrough[corr_core], DESC ),
			    bi_mart_energy_passthrough[lag_months]
			)
		formatString: 0
		displayFolder: Energy
		lineageTag: fc61f85a-17ee-4714-8a4e-abb1f065b113

	measure 'Peak Correlation to Core' =
			MAXX (
			    TOPN ( 1, bi_mart_energy_passthrough, bi_mart_energy_passthrough[corr_core], DESC ),
			    bi_mart_energy_passthrough[corr_core]
			)
		formatString: 0.00
		displayFolder: Energy
		lineageTag: 2601634c-86ba-418a-8eed-79c7c7efbb00

	measure 'Pass-through Reading' =
			"Energy prices lead core inflation by about " & [Peak Lag to Core (months)]
			    & " months (correlation " & FORMAT ( [Peak Correlation to Core], "0.00" ) & ")"
		displayFolder: Energy
		lineageTag: a7b0b640-3f79-4ab4-9dd7-29b395027325

