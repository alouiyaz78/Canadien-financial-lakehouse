{
  "name": "Canadian Winter",
  "dataColors": [
    "#0B2545",
    "#C8102E",
    "#4A90C2",
    "#2F5D50",
    "#3FB8AF",
    "#C9A227",
    "#8E9AAF",
    "#5C6B7A"
  ],
  "background": "#FFFFFF",
  "foreground": "#0B2545",
  "tableAccent": "#0B2545",
  "good": "#2F5D50",
  "neutral": "#8E9AAF",
  "bad": "#C8102E",
  "maximum": "#C8102E",
  "center": "#EEF3F8",
  "minimum": "#2F5D50",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 13, "color": "#0B2545" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0B2545" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#5C6B7A" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#0B2545" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [{ "show": true, "color": { "solid": { "color": "#DCE4EC" } }, "radius": 10 }],
        "dropShadow": [{ "show": false }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "title": [{ "fontColor": { "solid": { "color": "#0B2545" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#EEF3F8" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#DCE4EC" } } }]
      }
    },
    "textbox": {
      "*": {
        "border": [{ "show": false }],
        "background": [{ "show": false }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 2.5 }],
        "categoryAxis": [{ "gridlineShow": false }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#E3E9EF" } } }]
      }
    }
  }
}
