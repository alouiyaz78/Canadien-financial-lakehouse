// =====================================================================================
// Canadian Financial Lakehouse — Power BI measures
// Create a table "_Measures" (Enter data → one empty column → load, then hide the column)
// and paste each measure below into it. Display folders are given in the comments.
//
// What-if parameters to create first (Modeling → New parameter → Numeric range):
//   Neutral real rate   0 → 2     step 0.25   default 0.75
//   Inflation weight    0 → 1.5   step 0.1    default 0.5
//   Slack weight        0 → 1.5   step 0.1    default 0.5
//   Mortgage amount     100000 → 1500000  step 25000  default 500000
//   Amortization years  15 → 30   step 1      default 25
// Power BI then creates measures named [Neutral real rate Value], etc.
// =====================================================================================


// ---------------------------------------------------------------- 1 · Policy monitor
// Folder: Policy

Policy Rate (latest) =
VAR LastDay =
    CALCULATE (
        MAX ( bi_fact_yield_curve[date] ),
        bi_fact_yield_curve[tenor] = "Overnight",
        REMOVEFILTERS ( bi_dim_date )
    )
RETURN
    CALCULATE (
        MAX ( bi_fact_yield_curve[yield_pct] ),
        bi_fact_yield_curve[tenor] = "Overnight",
        bi_fact_yield_curve[date] = LastDay,
        REMOVEFILTERS ( bi_dim_date )
    )

Last Decision =
// [date] is the effective date (day after); show the announcement date
VAR LastMove = CALCULATE ( MAX ( bi_fact_policy_decisions[announcement_date] ), REMOVEFILTERS ( bi_dim_date ) )
VAR Bp = CALCULATE ( MAX ( bi_fact_policy_decisions[change_bp] ), bi_fact_policy_decisions[announcement_date] = LastMove, REMOVEFILTERS ( bi_dim_date ) )
RETURN
    IF ( Bp > 0, "+", "" ) & Bp & " bp on " & FORMAT ( LastMove, "d mmm yyyy" )

Next Decision Date =
CALCULATE (
    MIN ( bi_fact_policy_calendar[date] ),
    bi_fact_policy_calendar[date] >= TODAY (),
    REMOVEFILTERS ( bi_dim_date )
)

Days to Next Decision =
DATEDIFF ( TODAY (), [Next Decision Date], DAY )

Policy Rate = AVERAGE ( bi_mart_macro_monthly[policy_rate] )

Real Policy Rate = AVERAGE ( bi_mart_macro_monthly[real_policy_rate] )

Market-Implied Move 6M (bp) = AVERAGE ( bi_mart_macro_monthly[market_implied_6m_bp] )

Market Pricing Label =
VAR M = CALCULATE ( MAX ( bi_mart_macro_monthly[month] ), NOT ISBLANK ( bi_mart_macro_monthly[market_implied_6m_bp] ) )
VAR Bp = CALCULATE ( [Market-Implied Move 6M (bp)], bi_mart_macro_monthly[month] = M )
RETURN
    SWITCH ( TRUE (), Bp >= 15, "Markets price hikes", Bp <= -15, "Markets price cuts", "Markets price a hold" )

// Taylor rule with the what-if parameters (the Gold column taylor_rule_rate uses the defaults)
Taylor Rule Rate =
// Months without core inflation or unemployment (current, unpublished month) stay blank instead of dropping to r*
AVERAGEX (
    FILTER (
        bi_mart_macro_monthly,
        NOT ISBLANK ( bi_mart_macro_monthly[core_avg] ) && NOT ISBLANK ( bi_mart_macro_monthly[unemployment_gap] )
    ),
    [Neutral real rate Value]
        + bi_mart_macro_monthly[core_avg]
        + [Inflation weight Value] * ( bi_mart_macro_monthly[core_avg] - 2 )
        - [Slack weight Value] * 2 * bi_mart_macro_monthly[unemployment_gap]
)

Taylor Gap = [Policy Rate] - [Taylor Rule Rate]

Taylor Reading =
// Latest month with core inflation published (the current month is still empty)
VAR M = CALCULATE ( MAX ( bi_mart_macro_monthly[month] ), NOT ISBLANK ( bi_mart_macro_monthly[taylor_rule_rate] ) )
VAR Gap = CALCULATE ( [Taylor Gap], bi_mart_macro_monthly[month] = M )
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( Gap ), BLANK (),
        Gap < -0.5, "Policy looser than the rule → argues for hikes",
        Gap > 0.5, "Policy tighter than the rule → argues for cuts",
        "Policy close to the rule"
    )

Net Policy Stance = SUM ( bi_mart_policy_signals[signal] )

Net Policy Stance Label =
VAR S = [Net Policy Stance]
RETURN
    SWITCH ( TRUE (), S >= 2, "Hawkish bias", S <= -2, "Dovish bias", "Balanced" )

Hawkish Signals = CALCULATE ( COUNTROWS ( bi_mart_policy_signals ), bi_mart_policy_signals[signal] = 1 )
Dovish Signals = CALCULATE ( COUNTROWS ( bi_mart_policy_signals ), bi_mart_policy_signals[signal] = -1 )

// Conditional formatting for the scorecard table (Format → Cell elements → Background → Field value)
Signal Color =
SWITCH ( MAX ( bi_mart_policy_signals[signal] ), 1, "#C8102E", -1, "#2F5D50", "#8E9AAF" )


// ---------------------------------------------------------------- Inflation
// Folder: Inflation

Headline CPI (y/y) = AVERAGE ( bi_mart_macro_monthly[cpi_headline_yoy] )
CPI-trim = AVERAGE ( bi_mart_macro_monthly[cpi_trim] )
CPI-median = AVERAGE ( bi_mart_macro_monthly[cpi_median] )
CPI-common = AVERAGE ( bi_mart_macro_monthly[cpi_common] )
Core Inflation (avg) = AVERAGE ( bi_mart_macro_monthly[core_avg] )
Core Measures Spread = AVERAGE ( bi_mart_macro_monthly[core_range] )
Target = 2
Target Band Low = 1
Target Band High = 3

Core vs Target (pts) = [Core Inflation (avg)] - [Target]

Months Outside Target Band =
COUNTROWS (
    FILTER (
        bi_mart_macro_monthly,
        bi_mart_macro_monthly[cpi_headline_yoy] > 3 || bi_mart_macro_monthly[cpi_headline_yoy] < 1
    )
)

// Latest-month KPIs (ignore the date slicer)
Latest Core Inflation =
VAR M = CALCULATE ( MAX ( bi_mart_macro_monthly[month] ), NOT ISBLANK ( bi_mart_macro_monthly[core_avg] ), REMOVEFILTERS ( bi_dim_date ) )
RETURN CALCULATE ( [Core Inflation (avg)], bi_mart_macro_monthly[month] = M, REMOVEFILTERS ( bi_dim_date ) )

Latest Headline CPI =
VAR M = CALCULATE ( MAX ( bi_mart_macro_monthly[month] ), NOT ISBLANK ( bi_mart_macro_monthly[cpi_headline_yoy] ), REMOVEFILTERS ( bi_dim_date ) )
RETURN CALCULATE ( [Headline CPI (y/y)], bi_mart_macro_monthly[month] = M, REMOVEFILTERS ( bi_dim_date ) )

Inflation Expectations 2-3Y = AVERAGE ( bi_mart_macro_monthly[infl_exp_consensus_2_3y] )


// ---------------------------------------------------------------- 2 · Oil shock
// Folder: Energy

WTI (USD) = AVERAGE ( bi_mart_macro_monthly[wti_usd] )
WTI (CAD) = AVERAGE ( bi_mart_macro_monthly[wti_cad] )
WTI CAD (y/y %) = AVERAGE ( bi_mart_macro_monthly[wti_cad_yoy] )
WTI USD (y/y %) = AVERAGE ( bi_mart_macro_monthly[wti_usd_yoy] )

// How much of the oil move the exchange rate amplified (+) or cushioned (−) for Canadians
FX Effect on Oil (pts) = [WTI CAD (y/y %)] - [WTI USD (y/y %)]

Energy Commodity Prices (y/y %) = AVERAGE ( bi_mart_macro_monthly[bcpi_energy_yoy] )
Headline minus Core (pts) = AVERAGE ( bi_mart_macro_monthly[headline_minus_core] )

Peak Lag to Core (months) =
MAXX (
    TOPN ( 1, bi_mart_energy_passthrough, bi_mart_energy_passthrough[corr_core], DESC ),
    bi_mart_energy_passthrough[lag_months]
)

Peak Correlation to Core =
MAXX (
    TOPN ( 1, bi_mart_energy_passthrough, bi_mart_energy_passthrough[corr_core], DESC ),
    bi_mart_energy_passthrough[corr_core]
)

Pass-through Reading =
"Energy prices lead core inflation by about " & [Peak Lag to Core (months)]
    & " months (correlation " & FORMAT ( [Peak Correlation to Core], "0.00" ) & ")"


// ---------------------------------------------------------------- 3 · Tariffs
// Folder: Trade

US Tariff on Canada (%) = AVERAGE ( bi_mart_macro_monthly[us_tariff_rate_on_canada] )
US Tariff on Mexico (%) = AVERAGE ( bi_mart_macro_monthly[us_tariff_rate_on_mexico] )
US Tariff on China (%) = AVERAGE ( bi_mart_macro_monthly[us_tariff_rate_on_china] )
Canada Advantage vs China (pts) = AVERAGE ( bi_mart_macro_monthly[canada_tariff_advantage_vs_china] )
US Import Prices from Canada (y/y %) = AVERAGE ( bi_mart_macro_monthly[us_import_prices_from_canada_yoy] )
Trade Policy Uncertainty = AVERAGE ( bi_mart_macro_monthly[trade_policy_uncertainty] )
USD/CAD = AVERAGE ( bi_mart_macro_monthly[usdcad] )

Tariff Change vs Pre-2025 (pts) =
VAR Baseline =
    CALCULATE (
        AVERAGE ( bi_mart_macro_monthly[us_tariff_rate_on_canada] ),
        DATESBETWEEN ( bi_dim_date[date], DATE ( 2024, 1, 1 ), DATE ( 2024, 12, 31 ) ),
        REMOVEFILTERS ( bi_dim_date )
    )
RETURN [US Tariff on Canada (%)] - Baseline

// Negative = Canadian exporters cut their prices, i.e. absorb part of the tariff
Exporter Absorption Reading =
VAR M = CALCULATE ( MAX ( bi_mart_macro_monthly[month] ), NOT ISBLANK ( bi_mart_macro_monthly[us_import_prices_from_canada_yoy] ) )
VAR P = CALCULATE ( [US Import Prices from Canada (y/y %)], bi_mart_macro_monthly[month] = M )
RETURN
    IF ( P < 0, "Canadian exporters are cutting prices (absorbing tariffs)", "No sign of price absorption by Canadian exporters" )


// ---------------------------------------------------------------- 4 · Mortgage renewal shock
// Folder: Mortgage
// Canadian fixed-rate mortgages compound semi-annually: monthly rate j = (1 + r/2)^(1/6) − 1.
// Posted conventional rates are higher than the rates most borrowers actually get: the
// simulator shows the *change* in payment, which is far less sensitive to that bias.

Mortgage 5Y Today (%) = AVERAGE ( bi_mart_macro_monthly[mortgage_5y] )
Mortgage 5Y at Origination (%) = AVERAGE ( bi_mart_macro_monthly[mortgage_5y_at_origination] )
Renewal Rate Change (pts) = AVERAGE ( bi_mart_macro_monthly[renewal_rate_change] )
Bank Mortgage Spread (pts) = AVERAGE ( bi_mart_macro_monthly[mortgage_spread_5y] )

Payment at Origination =
VAR R = [Mortgage 5Y at Origination (%)] / 100
VAR J = ( 1 + R / 2 ) ^ ( 1 / 6 ) - 1
VAR N = [Amortization years Value] * 12
RETURN [Mortgage amount Value] * J / ( 1 - ( 1 + J ) ^ ( -N ) )

Balance at Renewal =
VAR R = [Mortgage 5Y at Origination (%)] / 100
VAR J = ( 1 + R / 2 ) ^ ( 1 / 6 ) - 1
VAR P = [Payment at Origination]
RETURN [Mortgage amount Value] * ( 1 + J ) ^ 60 - P * ( ( 1 + J ) ^ 60 - 1 ) / J

Payment at Renewal =
VAR R = [Mortgage 5Y Today (%)] / 100
VAR J = ( 1 + R / 2 ) ^ ( 1 / 6 ) - 1
VAR N = [Amortization years Value] * 12 - 60
RETURN [Balance at Renewal] * J / ( 1 - ( 1 + J ) ^ ( -N ) )

Monthly Payment Shock ($) = [Payment at Renewal] - [Payment at Origination]
Monthly Payment Shock (%) = DIVIDE ( [Payment at Renewal], [Payment at Origination] ) - 1
Annual Payment Shock ($) = [Monthly Payment Shock ($)] * 12


// ---------------------------------------------------------------- Yield curve
// Folder: Curve  (axis: bi_fact_yield_curve[tenor], sorted by tenor_months)

Yield on Selected Date =
VAR D = MAX ( bi_dim_date[date] )
VAR LastD = CALCULATE ( MAX ( bi_fact_yield_curve[date] ), bi_fact_yield_curve[date] <= D, REMOVEFILTERS ( bi_dim_date ) )
RETURN CALCULATE ( AVERAGE ( bi_fact_yield_curve[yield_pct] ), bi_fact_yield_curve[date] = LastD, REMOVEFILTERS ( bi_dim_date ) )

Yield 1 Year Earlier =
VAR D = MAX ( bi_dim_date[date] ) - 365
VAR LastD = CALCULATE ( MAX ( bi_fact_yield_curve[date] ), bi_fact_yield_curve[date] <= D, REMOVEFILTERS ( bi_dim_date ) )
RETURN CALCULATE ( AVERAGE ( bi_fact_yield_curve[yield_pct] ), bi_fact_yield_curve[date] = LastD, REMOVEFILTERS ( bi_dim_date ) )

10Y-2Y Spread = AVERAGE ( bi_mart_macro_monthly[term_spread_10y_2y] )

Curve Inverted =
VAR M = CALCULATE ( MAX ( bi_mart_macro_monthly[month] ), NOT ISBLANK ( bi_mart_macro_monthly[term_spread_10y_2y] ) )
RETURN IF ( CALCULATE ( [10Y-2Y Spread], bi_mart_macro_monthly[month] = M ) < 0, "Inverted", "Normal" )


// ---------------------------------------------------------------- 5 · Pipeline health (bonus)
// Folder: Ops  (tables: freshness_report, bronze_ingestion_log)

Series Monitored = COUNTROWS ( freshness_report )
Series Late or Missing = CALCULATE ( COUNTROWS ( freshness_report ), freshness_report[status] IN { "late", "missing" } )
Data Freshness Score = DIVIDE ( CALCULATE ( COUNTROWS ( freshness_report ), freshness_report[status] IN { "ok", "retired" } ), [Series Monitored] )
Ingestion Runs = DISTINCTCOUNT ( bronze_ingestion_log[run_id] )
Series Changed (runs) = CALCULATE ( COUNTROWS ( bronze_ingestion_log ), bronze_ingestion_log[changed] = TRUE () )
Ingestion Errors = CALCULATE ( COUNTROWS ( bronze_ingestion_log ), bronze_ingestion_log[status] = "error" )
